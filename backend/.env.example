# Database
DATABASE_URL="postgresql://vetra:vetra123@localhost:5432/vetra?schema=public"

# Server
PORT=3001
HOST=localhost

# JWT (required for authentication)
JWT_SECRET=your-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=2h
JWT_REFRESH_TOKEN_EXPIRES_IN=7d

# Cookie secret for signing cookies
COOKIE_SECRET=your-cookie-secret-here-change-in-production

# CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.pupify.com.br

# Environment
NODE_ENV=development

# Backblaze B2 S3
B2_ENDPOINT=s3.us-west-001.backblazeb2.com
B2_BUCKET_NAME=your-bucket-name
B2_ACCESS_KEY_ID=your-access-key
B2_SECRET_ACCESS_KEY=your-secret-key
B2_REGION=us-west-001

# AI Services (OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key

# Rate Limiting (set to 0 to disable in development)
RATE_LIMIT_MAX=0
RATE_LIMIT_TIME_WINDOW=1 minute
RATE_LIMIT_ENABLED=false

# WhatsApp (Evolution API)
EVOLUTION_API_URL=https://evo.pupify.com.br
EVOLUTION_API_KEY=your-evolution-api-key
WEBHOOK_SECRET=your-random-webhook-secret
PUBLIC_API_URL=https://api.pupify.com.br

# Email (SMTP - Google Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@pupify.com
EMAIL_FROM_NAME=Pupify
